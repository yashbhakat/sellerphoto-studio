{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sellerphoto-fulfilment",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ALLOWED_ORIGIN": "https://sellerphotostudio.in",
    "FRONTEND_URL": "https://sellerphotostudio.in",
    "PRODUCT_KEY": "seller-photo-studio/v1.1.0/SellerPhotoStudio-v1.1.0.zip",
    "PRODUCT_FILENAME": "SellerPhotoStudio-v1.1.0.zip",
    "PRODUCT_VERSION": "1.1.0",
    "PRODUCT_AMOUNT": "49900",
    "PRODUCT_CURRENCY": "INR",
    "PRODUCT_SHA256": "50257132C4FAC9EF007158A6FFDE395453E5E4742DFEFC42145CFC2F6F4EC00A",
    "DOWNLOAD_TTL_SECONDS": "604800",
    "MAX_DOWNLOADS": "3",
    "ADMIN_USERNAME": "admin"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sellerphoto-fulfilment",
    "database_id": "f69f5698-2fbc-45ab-8059-1440115826e0",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "PRODUCTS",
    "bucket_name": "sellerphoto-products"
  }]
}
