# Public product checkout URL created in Razorpay Dashboard.
# Example: https://rzp.io/rzp/your-payment-page
NEXT_PUBLIC_CHECKOUT_URL=

# Google Analytics 4 measurement ID. Analytics loads only after visitor consent.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Set by the hosting workflow for production; leave empty locally.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_PATH=
